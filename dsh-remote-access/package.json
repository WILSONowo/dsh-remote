{
  "name": "dsh-remote-access",
  "version": "3.0.0",
  "description": "DSH 手机远程访问：独立设备配对、直连、自建中转及 0.2.1-rc.5 协议适配",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./tunnel": "./lib/tunnel.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:client": "esbuild src/client.ts --bundle --platform=browser --format=iife --outfile=lib/client.js --target=es2020",
    "test": "node --test test/*.test.mjs smoke-test.mjs",
    "prepack": "npm run typecheck && npm run build && npm run build:client && npm test",
    "pack": "npm pack"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh": "^0.1.0-rc.7 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1 || ^0.2.1-rc.5"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Cleartext stays allowed only for the outer hop to a LAN computer (ws://ip:port/api/remote-access/secure).
      All API data, tokens and pairing secrets travel inside a TLS 1.3 session pinned to the computer's key
      (docs/e2e-secure-channel.md); the app never sends them as plain HTTP.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
